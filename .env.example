# Plantilla para `uv run python scripts/task.py run <componente>`.
# Copie a `.env` (ignorado por Git). Nunca escriba aquí credenciales reales ni de GCP.
# Formato: CLAVE=valor, sin comentarios en la misma línea.

# Comunes a todos los componentes.
# APP_ENV: local | test | development | staging | production
APP_ENV=local
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
SERVICE_VERSION=0.0.0-local

# Pool hacia PostgreSQL (servicios con base propia).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_SECONDS=5

# Dominios CQRS (users, training, events): escritura y lectura separadas.
DATABASE_WRITE_URL=postgresql+psycopg://usuario:CAMBIAR@127.0.0.1:5432/usuarios_write
DATABASE_READ_URL=postgresql+psycopg://usuario:CAMBIAR@127.0.0.1:5432/usuarios_read

# users-management: versión vigente de las políticas que se aceptan al registrarse (HU001,
# decisión del 2026-10-17). Marco de referencia: Convenios 108 y 108+ del Consejo de Europa;
# no implica certificación ni sustituye el aviso de privacidad propio de SportApp.
REGISTRATION_POLICIES_VERSION=sportapp-c108-c108plus.v1

# users-management, HU005 (ADR-034) y HU009 (ADR-035): versión vigente del consentimiento de
# datos de salud (perfil fisiológico y hábitos alimenticios). training-management, HU042
# (ADR-037): la misma versión para los reportes de salud.
# Obligatoria: sin ella el servicio no arranca. Valor solo local; la política real sigue pendiente.
HEALTH_DATA_CONSENT_VERSION=local-dev

# users-management, HU003: clave privada Ed25519 (PEM en una sola línea, con \n literales).
# Genérela con el comando de la sección "Configuración" del README; nunca la versione.
JWT_PRIVATE_KEY=CAMBIAR
# Opcionales (valores por defecto aprobados): emisor, audiencia y vigencias en segundos.
# JWT_ISSUER=sportapp-users-management
# JWT_AUDIENCE=sportapp
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=604800
# LOGIN_MAX_FAILURES=5
# LOGIN_FAILURE_WINDOW_SECONDS=900

# users-management-outbox-publisher (python -m users_management.workers.outbox_publisher).
PUBSUB_PROJECT_ID=sportapp-local
PUBSUB_EMULATOR_HOST=127.0.0.1:58085

# events-management, HU039 (ADR-045): push FCM opcional (desactivado por defecto).
# Con FCM_ENABLED=true hacen falta PUSH_TOKEN_ENCRYPTION_KEY (32 bytes en base64 URL-safe)
# y, en el proyector, FCM_PROJECT_ID y FCM_SERVICE_ACCOUNT (ruta al JSON). Nunca los versione.
# FCM_ENABLED=false
# PUSH_TOKEN_ENCRYPTION_KEY=
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT=
# Proyector con FCM: base de escritura (tokens y resultados), destino y timeout de FCM y
# envíos simultáneos y en cola (no frenan el ACK).
# DATABASE_WRITE_URL=
# FCM_BASE_URL=https://fcm.googleapis.com
# FCM_TIMEOUT_SECONDS=5
# PUSH_WORKERS=4
# PUSH_QUEUE_SIZE=200
# eventos-notificaciones-worker y planificador de recordatorios (opcionales).
# NOTIFICATIONS_SUBSCRIPTION=eventos-notificaciones-v1
# REMINDER_INTERVAL_SECONDS=900

# bff-web y bff-mobile, HU003 GET /v1/me/capabilities: contrato interno de afiliación.
AFFILIATION_MANAGEMENT_BASE_URL=http://127.0.0.1:8002
# Opcionales: iss/aud esperados (por defecto los de users-management) y ruta del contrato de
# permisos (por defecto contracts/authorization/actor-permissions.v2.json del repositorio).
# JWT_ISSUER=sportapp-users-management
# JWT_AUDIENCE=sportapp
# ACTOR_PERMISSIONS_PATH=contracts/authorization/actor-permissions.v2.json
# bff-web y bff-mobile: URL del servicio de usuarios y timeout hacia los servicios (segundos).
USERS_MANAGEMENT_BASE_URL=http://127.0.0.1:8001
UPSTREAM_TIMEOUT_SECONDS=5
# bff-web (HU010) y bff-mobile (HU032): servicio de entrenamientos.
TRAINING_MANAGEMENT_BASE_URL=http://127.0.0.1:8004
# bff-web (HU015) y bff-mobile (HU029): servicios complementarios.
COMPLEMENTARY_SERVICES_BASE_URL=http://127.0.0.1:8003
# bff-web (HU021) y bff-mobile (HU035 y HU041): eventos masivos.
EVENTS_MANAGEMENT_BASE_URL=http://127.0.0.1:8005
# events-management, HU021, HU035 y HU041: usa USERS_MANAGEMENT_BASE_URL (JWKS),
# AFFILIATION_MANAGEMENT_BASE_URL (capacidad calendar.sport.view) y los opcionales
# UPSTREAM_TIMEOUT_SECONDS, JWT_ISSUER, JWT_AUDIENCE y ACTOR_PERMISSIONS_PATH de arriba,
# además de DATABASE_WRITE_URL y DATABASE_READ_URL.
# complementary-services, HU015 y HU020: usa USERS_MANAGEMENT_BASE_URL (JWKS),
# AFFILIATION_MANAGEMENT_BASE_URL (capacidad services.sports_medicine.access) y los opcionales
# JWT_ISSUER, JWT_AUDIENCE y ACTOR_PERMISSIONS_PATH de arriba, además de DATABASE_URL.
# training-management, HU010 y HU014: usa USERS_MANAGEMENT_BASE_URL (JWKS y restricciones
# alimenticias), AFFILIATION_MANAGEMENT_BASE_URL
# (capacidades), UPSTREAM_TIMEOUT_SECONDS y los opcionales JWT_ISSUER, JWT_AUDIENCE y
# ACTOR_PERMISSIONS_PATH de arriba, además de DATABASE_WRITE_URL y DATABASE_READ_URL.
# bff-web: orígenes del cliente web permitidos por CORS, separados por comas (vacío: ninguno).
# Son también los únicos `Origin` aceptados para iniciar y renovar sesión (CSRF).
CORS_ALLOWED_ORIGINS=http://localhost:18082,http://localhost:4200
# bff-web: SameSite de la cookie del refresh token: strict | lax | none (por defecto strict).
# REFRESH_COOKIE_SAME_SITE=strict

# Dominios con base única (affiliation, complementary services).
# DATABASE_URL=postgresql+psycopg://usuario:CAMBIAR@127.0.0.1:5432/afiliacion

# affiliation-management (ADR-024 y ADR-036): catálogo instalado por la migración 0003.
AFFILIATION_EXPECTED_CATALOG_VERSION=plans-2026-10-13.v1
# affiliation-management, HU016: usa también USERS_MANAGEMENT_BASE_URL (JWKS para verificar el
# token del deportista) y los opcionales UPSTREAM_TIMEOUT_SECONDS, JWT_ISSUER y JWT_AUDIENCE.
# Workers de afiliación:
#   python -m affiliation_management.workers.pubsub_setup        (solo emulador)
#   python -m affiliation_management.workers.free_plan_consumer  (alta gratuita)
#   python -m affiliation_management.workers.outbox_publisher    (suscripcion.activada.v1 y suscripcion.cambiada.v1)
# FREE_PLAN_SUBSCRIPTION=sportapp.afiliacion.alta-gratuita.v1
# CONSUMER_MAX_MESSAGES=10

# Workers de entrenamientos (HU010, CMP-003):
#   python -m training_management.workers.pubsub_setup      (solo emulador)
#   python -m training_management.workers.outbox_publisher  (plan.entrenamiento_creado.v1; DATABASE_WRITE_URL)
#   python -m training_management.workers.read_projector    (vista de lectura; DATABASE_READ_URL)
# PROJECTOR_SUBSCRIPTION=proyector-entrenamientos-v1

# Workers de eventos masivos (HU021, CMP-004):
#   python -m events_management.workers.pubsub_setup      (solo emulador)
#   python -m events_management.workers.outbox_publisher  (evento.creado.v1; DATABASE_WRITE_URL)
#   python -m events_management.workers.read_projector    (event_read; DATABASE_READ_URL)
# PROJECTOR_SUBSCRIPTION=proyector-eventos-v1

# Workers de servicios complementarios (HU019, ADR-027); usan DATABASE_URL,
# PUBSUB_PROJECT_ID y PUBSUB_EMULATOR_HOST de arriba:
#   python -m complementary_services.workers.pubsub_setup      (solo emulador; solo el tópico)
#   python -m complementary_services.workers.outbox_publisher  (servicio.publicado.v1)
# PUBSUB_TOPIC=sportapp.servicios.v1
# Opcionales de los publicadores outbox (valores por defecto; WORKER_ID toma el nombre
# del host si no se define):
# OUTBOX_BATCH_SIZE=100
# OUTBOX_LEASE_SECONDS=30
# OUTBOX_BUSY_POLL_SECONDS=0.25
# OUTBOX_IDLE_POLL_MAX_SECONDS=2

# Pruebas de integración: PostgreSQL efímero creado con `scripts/task.py db-up`.
TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:55432/postgres
