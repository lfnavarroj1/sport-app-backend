{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sportapp/contracts/events/entrenamientos/plan.entrenamiento_creado.v1.schema.json",
  "title": "plan.entrenamiento_creado.v1",
  "description": "Publicado en sportapp.entrenamientos.v1 con ordering_key = plan_id (= aggregate_id) cuando un profesional autorizado crea y asigna un plan (HU010, CMP-003; payload aprobado el 2026-10-12). Lleva el contenido estructurado que necesita entrenamientos-read-projector. No transporta datos de perfil, nombres, correos ni texto libre clínico.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "producer",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "correlation_id",
    "causation_id",
    "schema_version",
    "payload"
  ],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "plan.entrenamiento_creado.v1"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "producer": {"const": "training-management"},
    "aggregate_type": {"const": "training_plan"},
    "aggregate_id": {
      "type": "string",
      "format": "uuid",
      "description": "plan_id: una secuencia de versiones por plan."
    },
    "aggregate_version": {"type": "integer", "minimum": 1},
    "correlation_id": {"type": ["string", "null"], "format": "uuid"},
    "causation_id": {
      "type": ["string", "null"],
      "description": "Idempotency-Key del comando que creó el plan."
    },
    "schema_version": {"const": 1},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "athlete_id",
        "professional_id",
        "title",
        "objectives",
        "start_date",
        "end_date",
        "status",
        "plan_version",
        "sessions",
        "created_at"
      ],
      "properties": {
        "plan_id": {"type": "string", "format": "uuid"},
        "athlete_id": {"type": "string", "format": "uuid"},
        "professional_id": {"type": "string", "format": "uuid"},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "objectives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"},
        "status": {"const": "ASSIGNED"},
        "plan_version": {"type": "integer", "minimum": 1},
        "sessions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scheduled_date", "sport", "duration_minutes", "intensity_rpe"],
            "properties": {
              "scheduled_date": {"type": "string", "format": "date"},
              "sport": {"enum": ["running", "cycling", "swimming", "strength", "other"]},
              "duration_minutes": {"type": "integer", "minimum": 1, "maximum": 600},
              "intensity_rpe": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10,
                "description": "Intensidad percibida RPE, escala CR10."
              }
            }
          }
        },
        "created_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
