{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sportapp/contracts/events/entrenamientos/plantilla_entrenamiento.publicada.v1.schema.json",
  "title": "plantilla_entrenamiento.publicada.v1",
  "description": "Publicado en sportapp.entrenamientos.v1 con ordering_key = template_id (= aggregate_id) cuando un profesional publica una plantilla de plan (HU028, ADR-041). Estado completo de la plantilla en su versión 1 para entrenamientos-read-projector (training_plan_template_view). No es un plan asignado: sin deportista ni fechas. Instantes en UTC con sufijo Z.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "producer",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "correlation_id",
    "causation_id",
    "schema_version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "plantilla_entrenamiento.publicada.v1"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "training-management"
    },
    "aggregate_type": {
      "const": "training_plan_template"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid",
      "description": "template_id de la plantilla; también es la ordering_key."
    },
    "aggregate_version": {
      "const": 1,
      "description": "Igual a payload.version."
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Idempotency-Key de la publicación"
    },
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "professional_id",
        "title",
        "objectives",
        "sport",
        "goal",
        "level",
        "duration_weeks",
        "weekly_sessions",
        "status",
        "version",
        "created_at",
        "updated_at",
        "published_at",
        "retired_at"
      ],
      "properties": {
        "template_id": {
          "type": "string",
          "format": "uuid"
        },
        "professional_id": {
          "type": "string",
          "format": "uuid",
          "description": "Profesional autor (único dato personal: un identificador)."
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "objectives": {
          "type": "string",
          "minLength": 20,
          "maxLength": 2000
        },
        "sport": {
          "enum": [
            "running",
            "cycling",
            "swimming",
            "strength",
            "other"
          ]
        },
        "goal": {
          "enum": [
            "HEALTH",
            "PERFORMANCE",
            "WEIGHT_MANAGEMENT",
            "RECREATION",
            "COMPETITION"
          ]
        },
        "level": {
          "enum": [
            "BEGINNER",
            "INTERMEDIATE",
            "ADVANCED"
          ]
        },
        "duration_weeks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52
        },
        "weekly_sessions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 14,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "day_of_week",
              "description",
              "duration_minutes"
            ],
            "properties": {
              "day_of_week": {
                "enum": [
                  "MON",
                  "TUE",
                  "WED",
                  "THU",
                  "FRI",
                  "SAT",
                  "SUN"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "duration_minutes": {
                "type": "integer",
                "minimum": 10,
                "maximum": 600
              }
            }
          }
        },
        "status": {
          "const": "PUBLISHED"
        },
        "version": {
          "const": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "published_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "retired_at": {
          "type": "null"
        }
      }
    }
  }
}
