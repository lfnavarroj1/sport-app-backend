{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sportapp/contracts/events/entrenamientos/plantilla_rutina.retirada.v1.schema.json",
  "title": "plantilla_rutina.retirada.v1",
  "description": "Publicado en sportapp.entrenamientos.v1 con ordering_key = template_id (= aggregate_id) cuando el profesional retira una rutina alimenticia propia (HU030, ADR-041). Estado completo con la versión siguiente; la rutina se conserva y deja de sugerirse. Instantes en UTC con sufijo Z.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "producer",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "correlation_id",
    "causation_id",
    "schema_version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "plantilla_rutina.retirada.v1"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "training-management"
    },
    "aggregate_type": {
      "const": "nutrition_routine_template"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid",
      "description": "template_id de la rutina; también es la ordering_key."
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 2,
      "description": "Igual a payload.version."
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "template_id de la rutina retirada (el retiro no lleva clave)"
    },
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "professional_id",
        "title",
        "description",
        "goal",
        "sport",
        "dietary_pattern",
        "contains_allergens",
        "duration_days",
        "daily_meals",
        "status",
        "version",
        "created_at",
        "updated_at",
        "published_at",
        "retired_at"
      ],
      "properties": {
        "template_id": {
          "type": "string",
          "format": "uuid"
        },
        "professional_id": {
          "type": "string",
          "format": "uuid",
          "description": "Profesional autor (único dato personal: un identificador)."
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "goal": {
          "enum": [
            "HEALTH",
            "PERFORMANCE",
            "WEIGHT_MANAGEMENT",
            "RECREATION",
            "COMPETITION"
          ]
        },
        "sport": {
          "enum": [
            "running",
            "cycling",
            "swimming",
            "strength",
            "other",
            null
          ]
        },
        "dietary_pattern": {
          "enum": [
            "OMNIVORE",
            "VEGETARIAN",
            "VEGAN",
            "PESCATARIAN",
            "FLEXITARIAN"
          ]
        },
        "contains_allergens": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "description": "Alérgenos de la rutina en el orden del catálogo de HU009 (declarados más los del catálogo de alimentos).",
          "items": {
            "enum": [
              "PEANUTS",
              "TREE_NUTS",
              "MILK",
              "EGGS",
              "WHEAT",
              "SOY",
              "FISH",
              "SHELLFISH",
              "SESAME"
            ]
          }
        },
        "duration_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "daily_meals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "meal",
              "items"
            ],
            "properties": {
              "meal": {
                "enum": [
                  "BREAKFAST",
                  "LUNCH",
                  "DINNER",
                  "SNACK",
                  "HYDRATION"
                ]
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 15,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "food_code",
                    "portions"
                  ],
                  "properties": {
                    "food_code": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "description": "Código del catálogo de alimentos (food-catalog-2026-10-13.v1)."
                    },
                    "portions": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10
                    }
                  }
                }
              }
            }
          }
        },
        "status": {
          "const": "RETIRED"
        },
        "version": {
          "type": "integer",
          "minimum": 2
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "published_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "retired_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    }
  }
}
