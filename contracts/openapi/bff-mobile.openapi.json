{
  "components": {
    "schemas": {
      "ActiveTrainingSessionResponse": {
        "description": "Sesión activa proyectada (lectura eventual).",
        "properties": {
          "athlete_id": {
            "format": "uuid",
            "title": "Athlete Id",
            "type": "string"
          },
          "plan_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Id"
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          },
          "sport": {
            "enum": [
              "running",
              "cycling",
              "swimming",
              "strength",
              "other"
            ],
            "title": "Sport",
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "status": {
            "const": "ACTIVE",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "session_id",
          "athlete_id",
          "plan_id",
          "sport",
          "started_at",
          "status",
          "version"
        ],
        "title": "ActiveTrainingSessionResponse",
        "type": "object"
      },
      "CapabilitiesResponse": {
        "properties": {
          "actor_type": {
            "enum": [
              "athlete",
              "organizer",
              "service_provider"
            ],
            "title": "Actor Type",
            "type": "string"
          },
          "authorization_policy_version": {
            "title": "Authorization Policy Version",
            "type": "string"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "catalog_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Catalog Version"
          },
          "evaluated_at": {
            "format": "date-time",
            "title": "Evaluated At",
            "type": "string"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          },
          "plan_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Code"
          },
          "plan_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Version"
          },
          "subscription_status": {
            "enum": [
              "ACTIVE",
              "PROVISIONING",
              "NOT_APPLICABLE"
            ],
            "title": "Subscription Status",
            "type": "string"
          }
        },
        "required": [
          "actor_type",
          "subscription_status",
          "plan_code",
          "plan_version",
          "catalog_version",
          "authorization_policy_version",
          "permissions",
          "capabilities",
          "evaluated_at"
        ],
        "title": "CapabilitiesResponse",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "issue": {
            "title": "Issue",
            "type": "string"
          }
        },
        "required": [
          "issue"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthStatus": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
                "ok",
                "failed"
              ],
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 1,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "RefreshSessionRequest": {
        "additionalProperties": false,
        "properties": {
          "refresh_token": {
            "format": "password",
            "maxLength": 256,
            "minLength": 20,
            "title": "Refresh Token",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshSessionRequest",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "description": "Segundos de vigencia del access token.",
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_expires_in": {
            "description": "Segundos de vigencia del refresh token.",
            "title": "Refresh Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "const": "Bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          }
        },
        "required": [
          "token_type",
          "access_token",
          "expires_in",
          "refresh_token",
          "refresh_expires_in",
          "user"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SessionUser": {
        "properties": {
          "actor_type": {
            "enum": [
              "athlete",
              "organizer",
              "service_provider"
            ],
            "title": "Actor Type",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "full_name",
          "email",
          "actor_type"
        ],
        "title": "SessionUser",
        "type": "object"
      },
      "TrainingSessionResponse": {
        "description": "Sesión confirmada; `ended_at` y `duration_seconds` son `null` mientras está activa.",
        "properties": {
          "athlete_id": {
            "format": "uuid",
            "title": "Athlete Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "duration_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Calculada por el backend: `ended_at` - `started_at`.",
            "title": "Duration Seconds"
          },
          "ended_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At"
          },
          "plan_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Id"
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          },
          "sport": {
            "enum": [
              "running",
              "cycling",
              "swimming",
              "strength",
              "other"
            ],
            "title": "Sport",
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "FINISHED"
            ],
            "title": "Status",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "session_id",
          "athlete_id",
          "plan_id",
          "sport",
          "started_at",
          "ended_at",
          "duration_seconds",
          "status",
          "version",
          "created_at",
          "updated_at"
        ],
        "title": "TrainingSessionResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "SportApp - BFF móvil",
    "version": "0.5.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/me/capabilities": {
      "get": {
        "operationId": "get_capabilities_v1_me_capabilities_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`invalid_access_token`: falta el token o no es válido."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`unsupported_actor_type`: actor ausente o desconocido."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_unavailable`: no se pudo evaluar la identidad o el plan."
          }
        },
        "summary": "Identidad, permisos por actor y capacidades vigentes (HU003)",
        "tags": [
          "sessions"
        ]
      }
    },
    "/v1/sessions": {
      "post": {
        "operationId": "create_session_v1_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`invalid_credentials`: credenciales incorrectas o cuenta deshabilitada (mensaje genérico)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`validation_error`."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`too_many_attempts`; `Retry-After` indica los segundos de espera.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_unavailable`."
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_timeout`."
          }
        },
        "summary": "Iniciar sesión (HU003)",
        "tags": [
          "sessions"
        ]
      }
    },
    "/v1/sessions/refresh": {
      "post": {
        "operationId": "refresh_v1_sessions_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`invalid_refresh_token`."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`validation_error`."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_unavailable`."
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_timeout`."
          }
        },
        "summary": "Renovar la sesión (HU003)",
        "tags": [
          "sessions"
        ]
      }
    },
    "/v1/sessions/revoke": {
      "post": {
        "description": "Revoca la sesión del refresh token. Siempre `204` si el servicio confirma, también con una sesión ya cerrada o desconocida (idempotente). Con `503`/`504` la revocación remota no se confirmó: la aplicación conserva la credencial en su cola cifrada y reintenta (ADR-026, CA6-CA7). `Idempotency-Key` (UUID) es opcional y la cola la repite en cada reintento.",
        "operationId": "revoke_v1_sessions_revoke_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`validation_error`."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_unavailable`."
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_timeout`."
          }
        },
        "summary": "Cerrar sesión (HU004)",
        "tags": [
          "sessions"
        ]
      }
    },
    "/v1/training-sessions": {
      "post": {
        "operationId": "start_session_v1_training_sessions_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "description": "Esquema documentado del inicio; la validación la hace el servicio (ADR-029).",
                "properties": {
                  "plan_id": {
                    "anyOf": [
                      {
                        "format": "uuid",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Plan propio `ASSIGNED` que contiene el deporte; opcional.",
                    "title": "Plan Id"
                  },
                  "session_id": {
                    "description": "UUID v4 generado por el móvil.",
                    "format": "uuid",
                    "title": "Session Id",
                    "type": "string"
                  },
                  "sport": {
                    "enum": [
                      "running",
                      "cycling",
                      "swimming",
                      "strength",
                      "other"
                    ],
                    "title": "Sport",
                    "type": "string"
                  },
                  "started_at": {
                    "description": "Instante UTC con sufijo `Z` y precisión de segundos (`YYYY-MM-DDTHH:MM:SSZ`).",
                    "examples": [
                      "2026-10-12T12:30:00Z"
                    ],
                    "format": "date-time",
                    "title": "Started At",
                    "type": "string"
                  }
                },
                "required": [
                  "session_id",
                  "sport",
                  "started_at"
                ],
                "title": "StartTrainingSessionRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainingSessionResponse"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Idempotent-Replayed": {
                "description": "`true` cuando se devuelve un resultado ya confirmado.",
                "schema": {
                  "type": "string"
                }
              },
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`invalid_access_token`: falta el token o no es válido."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`permission_required` (no es deportista) o `capability_required` (`training.session.record`, solo al iniciar)."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`training_plan_not_found` o `training_session_not_found`."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`active_session_exists`, `session_id_reused`, `training_session_already_finished` o `idempotency_key_reused`."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
