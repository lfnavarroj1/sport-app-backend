{
  "components": {
    "schemas": {
      "CapabilitiesResponse": {
        "properties": {
          "actor_type": {
            "enum": [
              "athlete",
              "organizer",
              "service_provider"
            ],
            "title": "Actor Type",
            "type": "string"
          },
          "authorization_policy_version": {
            "title": "Authorization Policy Version",
            "type": "string"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "catalog_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Catalog Version"
          },
          "evaluated_at": {
            "format": "date-time",
            "title": "Evaluated At",
            "type": "string"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          },
          "plan_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Code"
          },
          "plan_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Version"
          },
          "subscription_status": {
            "enum": [
              "ACTIVE",
              "PROVISIONING",
              "NOT_APPLICABLE"
            ],
            "title": "Subscription Status",
            "type": "string"
          }
        },
        "required": [
          "actor_type",
          "subscription_status",
          "plan_code",
          "plan_version",
          "catalog_version",
          "authorization_policy_version",
          "permissions",
          "capabilities",
          "evaluated_at"
        ],
        "title": "CapabilitiesResponse",
        "type": "object"
      },
      "CreateTrainingPlanRequest": {
        "additionalProperties": false,
        "properties": {
          "athlete_email": {
            "format": "email",
            "maxLength": 254,
            "title": "Athlete Email",
            "type": "string"
          },
          "end_date": {
            "format": "date",
            "title": "End Date",
            "type": "string"
          },
          "objectives": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 5,
            "minItems": 1,
            "title": "Objectives",
            "type": "array"
          },
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/PlannedSession"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Sessions",
            "type": "array"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "athlete_email",
          "title",
          "objectives",
          "start_date",
          "end_date",
          "sessions"
        ],
        "title": "CreateTrainingPlanRequest",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "issue": {
            "title": "Issue",
            "type": "string"
          }
        },
        "required": [
          "issue"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "GrantAuthorizationRequest": {
        "additionalProperties": false,
        "properties": {
          "professional_email": {
            "format": "email",
            "maxLength": 254,
            "title": "Professional Email",
            "type": "string"
          }
        },
        "required": [
          "professional_email"
        ],
        "title": "GrantAuthorizationRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthStatus": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
                "ok",
                "failed"
              ],
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 1,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "PlannedSession": {
        "additionalProperties": false,
        "properties": {
          "duration_minutes": {
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Duration Minutes",
            "type": "integer"
          },
          "intensity_rpe": {
            "description": "Intensidad percibida RPE, escala CR10 (1 a 10).",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Intensity Rpe",
            "type": "integer"
          },
          "scheduled_date": {
            "format": "date",
            "title": "Scheduled Date",
            "type": "string"
          },
          "sport": {
            "enum": [
              "running",
              "cycling",
              "swimming",
              "strength",
              "other"
            ],
            "title": "Sport",
            "type": "string"
          }
        },
        "required": [
          "scheduled_date",
          "sport",
          "duration_minutes",
          "intensity_rpe"
        ],
        "title": "PlannedSession",
        "type": "object"
      },
      "RegisterUserRequest": {
        "additionalProperties": false,
        "properties": {
          "accepted_policies_version": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Accepted Policies Version",
            "type": "string"
          },
          "actor_type": {
            "enum": [
              "athlete",
              "organizer",
              "service_provider"
            ],
            "title": "Actor Type",
            "type": "string"
          },
          "email": {
            "format": "email",
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Full Name",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "full_name",
          "email",
          "password",
          "actor_type",
          "accepted_policies_version"
        ],
        "title": "RegisterUserRequest",
        "type": "object"
      },
      "SessionUser": {
        "properties": {
          "actor_type": {
            "enum": [
              "athlete",
              "organizer",
              "service_provider"
            ],
            "title": "Actor Type",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "full_name",
          "email",
          "actor_type"
        ],
        "title": "SessionUser",
        "type": "object"
      },
      "TrainingAuthorizationResponse": {
        "properties": {
          "athlete_id": {
            "format": "uuid",
            "title": "Athlete Id",
            "type": "string"
          },
          "granted_at": {
            "format": "date-time",
            "title": "Granted At",
            "type": "string"
          },
          "professional_id": {
            "format": "uuid",
            "title": "Professional Id",
            "type": "string"
          },
          "status": {
            "const": "ACTIVE",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "athlete_id",
          "professional_id",
          "status",
          "granted_at"
        ],
        "title": "TrainingAuthorizationResponse",
        "type": "object"
      },
      "TrainingPlanResponse": {
        "properties": {
          "athlete_id": {
            "format": "uuid",
            "title": "Athlete Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "end_date": {
            "format": "date",
            "title": "End Date",
            "type": "string"
          },
          "objectives": {
            "items": {
              "type": "string"
            },
            "title": "Objectives",
            "type": "array"
          },
          "plan_id": {
            "format": "uuid",
            "title": "Plan Id",
            "type": "string"
          },
          "professional_id": {
            "format": "uuid",
            "title": "Professional Id",
            "type": "string"
          },
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/PlannedSession"
            },
            "title": "Sessions",
            "type": "array"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          },
          "status": {
            "const": "ASSIGNED",
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "plan_id",
          "athlete_id",
          "professional_id",
          "title",
          "objectives",
          "start_date",
          "end_date",
          "status",
          "version",
          "sessions",
          "created_at"
        ],
        "title": "TrainingPlanResponse",
        "type": "object"
      },
      "UserRegisteredResponse": {
        "properties": {
          "actor_type": {
            "enum": [
              "athlete",
              "organizer",
              "service_provider"
            ],
            "title": "Actor Type",
            "type": "string"
          },
          "aggregate_version": {
            "title": "Aggregate Version",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "status": {
            "const": "active",
            "title": "Status",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "full_name",
          "email",
          "actor_type",
          "status",
          "aggregate_version",
          "created_at"
        ],
        "title": "UserRegisteredResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WebSessionResponse": {
        "description": "Sin `refresh_token`: viaja en la cookie `HttpOnly`.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "description": "Segundos de vigencia del access token.",
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_expires_in": {
            "description": "Segundos de vigencia de la sesión (refresh token en la cookie).",
            "title": "Refresh Expires In",
            "type": "integer"
          },
          "token_type": {
            "const": "Bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          }
        },
        "required": [
          "token_type",
          "access_token",
          "expires_in",
          "refresh_expires_in",
          "user"
        ],
        "title": "WebSessionResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "SportApp - BFF web",
    "version": "0.6.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/me/capabilities": {
      "get": {
        "operationId": "get_capabilities_v1_me_capabilities_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`invalid_access_token`: falta el token o no es válido."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`unsupported_actor_type`: actor ausente o desconocido."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_unavailable`: no se pudo evaluar la identidad o el plan."
          }
        },
        "summary": "Identidad, permisos por actor y capacidades vigentes (HU003)",
        "tags": [
          "sessions"
        ]
      }
    },
    "/v1/me/training-authorizations": {
      "post": {
        "operationId": "grant_authorization_v1_me_training_authorizations_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GrantAuthorizationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainingAuthorizationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainingAuthorizationResponse"
                }
              }
            },
            "description": "Autorización creada o reactivada (`200` si ya estaba activa)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`invalid_access_token`: falta el token o no es válido."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`permission_required` (no es deportista) o `capability_required` (`training.plan.manage`)."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`professional_not_found`: el correo no es de un profesional."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`validation_error`."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_unavailable`."
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_timeout`."
          }
        },
        "summary": "Autorizar a un profesional para asignarme planes (HU010)",
        "tags": [
          "training"
        ]
      }
    },
    "/v1/me/training-authorizations/{professional_id}": {
      "delete": {
        "operationId": "revoke_authorization_v1_me_training_authorizations__professional_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "professional_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Professional Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`invalid_access_token`: falta el token o no es válido."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`permission_required`: solo el deportista revoca."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_unavailable`."
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_timeout`."
          }
        },
        "summary": "Revocar la autorización de un profesional (HU010)",
        "tags": [
          "training"
        ]
      }
    },
    "/v1/sessions": {
      "post": {
        "operationId": "create_session_v1_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebSessionResponse"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Set-Cookie": {
                "description": "`__Secure-sportapp_refresh=<refresh token>; HttpOnly; Secure; Path=/v1/sessions; SameSite=<configurado>; Max-Age=<refresh_expires_in>`.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`invalid_credentials`: credenciales incorrectas o cuenta deshabilitada (mensaje genérico)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`origin_not_allowed`: falta `Origin` o no está en la lista permitida."
          },
          "422": {
            "content": {
