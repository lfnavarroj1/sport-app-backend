{
  "components": {
    "schemas": {
      "AuthorizationResponse": {
        "properties": {
          "authorization_url": {
            "description": "Consentimiento oficial de Strava con `scope=read,activity:read` y un `state` de un solo uso; el móvil la abre en Custom Tabs.",
            "title": "Authorization Url",
            "type": "string"
          },
          "expires_at": {
            "description": "Vencimiento del `state` (10 minutos), en UTC.",
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          }
        },
        "required": [
          "authorization_url",
          "expires_at"
        ],
        "title": "AuthorizationResponse",
        "type": "object"
      },
      "CallbackRequest": {
        "additionalProperties": false,
        "description": "Parámetros que Strava devolvió al callback público de `bff-mobile`.",
        "properties": {
          "code": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "error": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "scope": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scope"
          },
          "state": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          }
        },
        "title": "CallbackRequest",
        "type": "object"
      },
      "CallbackResponse": {
        "properties": {
          "result": {
            "enum": [
              "LINKED",
              "DENIED",
              "INVALID_STATE",
              "ERROR"
            ],
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "CallbackResponse",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "issue": {
            "title": "Issue",
            "type": "string"
          }
        },
        "required": [
          "issue"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthStatus": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
                "ok",
                "failed"
              ],
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "IntegrationStatusResponse": {
        "properties": {
          "external_athlete_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Identificador del atleta en Strava.",
            "title": "External Athlete Id"
          },
          "last_sync": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LastSyncResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "linked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Linked At"
          },
          "scopes": {
            "description": "Scopes aceptados; vacío sin vinculación.",
            "items": {
              "type": "string"
            },
            "title": "Scopes",
            "type": "array"
          },
          "status": {
            "enum": [
              "NOT_LINKED",
              "ACTIVE",
              "REVOKED",
              "EXPIRED"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "external_athlete_id",
          "linked_at",
          "scopes",
          "last_sync"
        ],
        "title": "IntegrationStatusResponse",
        "type": "object"
      },
      "LastSyncResponse": {
        "properties": {
          "error_code": {
            "anyOf": [
              {
                "enum": [
                  "rate_limited",
                  "provider_unavailable",
                  "circuit_open",
                  "token_expired",
                  "insufficient_scope",
                  "provider_rejected",
                  "invalid_response",
                  "invalid_activity",
                  "integration_revoked"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "imported_count": {
            "description": "Actividades nuevas o cambiadas publicadas.",
            "title": "Imported Count",
            "type": "integer"
          },
          "requested_at": {
            "format": "date-time",
            "title": "Requested At",
            "type": "string"
          },
          "status": {
            "enum": [
              "QUEUED",
              "RUNNING",
              "SUCCEEDED",
              "FAILED",
              "RATE_LIMITED"
            ],
            "title": "Status",
            "type": "string"
          },
          "sync_run_id": {
            "format": "uuid",
            "title": "Sync Run Id",
            "type": "string"
          }
        },
        "required": [
          "sync_run_id",
          "status",
          "requested_at",
          "finished_at",
          "imported_count",
          "error_code"
        ],
        "title": "LastSyncResponse",
        "type": "object"
      },
      "SyncAcceptedResponse": {
        "properties": {
          "status": {
            "description": "`QUEUED` al aceptarla; un reintento con la misma clave devuelve el estado actual de la corrida.",
            "enum": [
              "QUEUED",
              "RUNNING",
              "SUCCEEDED",
              "FAILED",
              "RATE_LIMITED"
            ],
            "title": "Status",
            "type": "string"
          },
          "sync_run_id": {
            "format": "uuid",
            "title": "Sync Run Id",
            "type": "string"
          }
        },
        "required": [
          "sync_run_id",
          "status"
        ],
        "title": "SyncAcceptedResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "SportApp - Gestión de terceros",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/integrations/strava/callback": {
      "post": {
        "description": "Solo lo llama `bff-mobile`, sin token de SportApp. `INVALID_STATE` si el `state` falta, no existe, venció, ya se usó o no corresponde; `DENIED` si el usuario rechazó o no concedió `activity:read`; `ERROR` si el intercambio del `code` falló o la cuenta de Strava ya está vinculada a otro deportista; `LINKED` si quedó vinculada.",
        "operationId": "callback_v1_integrations_strava_callback_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CallbackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallbackResponse"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Cache-Control": {
                "description": "`no-store`.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_unavailable`: Strava no está configurado."
          }
        },
        "summary": "Completar el callback OAuth de Strava (interno, HU031)",
        "tags": [
          "strava"
        ]
      }
    },
    "/v1/me/integrations/strava": {
      "delete": {
        "description": "Revoca en Strava (mejor esfuerzo), borra los tokens, marca `REVOKED` y cancela las corridas pendientes; las actividades importadas se conservan. Siempre `204`, también sin vinculación.",
        "operationId": "delete_v1_me_integrations_strava_delete",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response",
            "headers": {
              "Cache-Control": {
                "description": "`no-store`.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`invalid_access_token`: falta el token o no es válido."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`permission_required` (no es deportista) o `capability_required` (`integrations.strava.connect`)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_unavailable`: no se pudo verificar la identidad o el plan, o la integración con Strava no está configurada."
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_timeout`: Afiliación no respondió a tiempo."
          }
        },
        "summary": "Desvincular Strava (HU031)",
        "tags": [
          "strava"
        ]
      },
      "get": {
        "operationId": "status_v1_me_integrations_strava_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationStatusResponse"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Cache-Control": {
                "description": "`no-store`.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`invalid_access_token`: falta el token o no es válido."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`permission_required` (no es deportista) o `capability_required` (`integrations.strava.connect`)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_unavailable`: no se pudo verificar la identidad o el plan, o la integración con Strava no está configurada."
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_timeout`: Afiliación no respondió a tiempo."
          }
        },
        "summary": "Estado de la vinculación con Strava (HU031)",
        "tags": [
          "strava"
        ]
      }
    },
    "/v1/me/integrations/strava/authorization": {
      "post": {
        "description": "Crea un `state` de un solo uso (10 minutos) ligado al deportista y devuelve la URL del consentimiento oficial. El móvil nunca captura credenciales de Strava.",
        "operationId": "start_v1_me_integrations_strava_authorization_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizationResponse"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Cache-Control": {
                "description": "`no-store`.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`invalid_access_token`: falta el token o no es válido."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`permission_required` (no es deportista) o `capability_required` (`integrations.strava.connect`)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_unavailable`: no se pudo verificar la identidad o el plan, o la integración con Strava no está configurada."
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_timeout`: Afiliación no respondió a tiempo."
          }
        },
        "summary": "Iniciar la vinculación con Strava (HU031)",
        "tags": [
          "strava"
        ]
      }
    },
    "/v1/me/integrations/strava/syncs": {
      "post": {
        "description": "La importación es asíncrona (`terceros-sync-worker`). Reintentar con la misma `Idempotency-Key` (24 horas) devuelve la misma corrida con su estado actual y `Idempotent-Replayed: true`.",
        "operationId": "sync_v1_me_integrations_strava_syncs_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncAcceptedResponse"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Cache-Control": {
                "description": "`no-store`.",
                "schema": {
                  "type": "string"
                }
              },
              "Idempotent-Replayed": {
                "description": "`true` cuando se devuelve el resultado de un reintento.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`invalid_access_token`: falta el token o no es válido."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`permission_required` (no es deportista) o `capability_required` (`integrations.strava.connect`)."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`integration_not_linked` (sin vinculación `ACTIVE`) o `sync_in_progress` (ya hay una corrida `QUEUED`/`RUNNING`)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`validation_error`: `Idempotency-Key` `required` o `invalid_uuid`."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_unavailable`: no se pudo verificar la identidad o el plan, o la integración con Strava no está configurada."
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`upstream_timeout`: Afiliación no respondió a tiempo."
          }
        },
        "summary": "Solicitar una sincronización manual con Strava (HU031)",
        "tags": [
          "strava"
        ]
      }
    }
  }
}
