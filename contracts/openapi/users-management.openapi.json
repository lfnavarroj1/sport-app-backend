{
  "components": {
    "schemas": {
      "AccountStatus": {
        "enum": [
          "active",
          "disabled"
        ],
        "title": "AccountStatus",
        "type": "string"
      },
      "ActorType": {
        "enum": [
          "athlete",
          "organizer",
          "service_provider"
        ],
        "title": "ActorType",
        "type": "string"
      },
      "ErrorDetail": {
        "properties": {
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "issue": {
            "title": "Issue",
            "type": "string"
          }
        },
        "required": [
          "issue"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthStatus": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
                "ok",
                "failed"
              ],
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "JsonWebKey": {
        "properties": {
          "alg": {
            "title": "Alg",
            "type": "string"
          },
          "crv": {
            "title": "Crv",
            "type": "string"
          },
          "kid": {
            "title": "Kid",
            "type": "string"
          },
          "kty": {
            "title": "Kty",
            "type": "string"
          },
          "use": {
            "title": "Use",
            "type": "string"
          },
          "x": {
            "title": "X",
            "type": "string"
          }
        },
        "required": [
          "kty",
          "crv",
          "x",
          "kid",
          "alg",
          "use"
        ],
        "title": "JsonWebKey",
        "type": "object"
      },
      "JsonWebKeySet": {
        "properties": {
          "keys": {
            "items": {
              "$ref": "#/components/schemas/JsonWebKey"
            },
            "title": "Keys",
            "type": "array"
          }
        },
        "required": [
          "keys"
        ],
        "title": "JsonWebKeySet",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 1,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "RefreshSessionRequest": {
        "additionalProperties": false,
        "properties": {
          "refresh_token": {
            "format": "password",
            "maxLength": 256,
            "minLength": 20,
            "title": "Refresh Token",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshSessionRequest",
        "type": "object"
      },
      "RegisterUserRequest": {
        "additionalProperties": false,
        "properties": {
          "accepted_policies_version": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Accepted Policies Version",
            "type": "string"
          },
          "actor_type": {
            "$ref": "#/components/schemas/ActorType"
          },
          "email": {
            "format": "email",
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Full Name",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "full_name",
          "email",
          "password",
          "actor_type",
          "accepted_policies_version"
        ],
        "title": "RegisterUserRequest",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "description": "Segundos de vigencia del access token.",
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_expires_in": {
            "description": "Segundos de vigencia del refresh token.",
            "title": "Refresh Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "const": "Bearer",
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          }
        },
        "required": [
          "access_token",
          "expires_in",
          "refresh_token",
          "refresh_expires_in",
          "user"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SessionUser": {
        "properties": {
          "actor_type": {
            "$ref": "#/components/schemas/ActorType"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "full_name",
          "email",
          "actor_type"
        ],
        "title": "SessionUser",
        "type": "object"
      },
      "UserRegisteredResponse": {
        "properties": {
          "actor_type": {
            "$ref": "#/components/schemas/ActorType"
          },
          "aggregate_version": {
            "title": "Aggregate Version",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AccountStatus"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "full_name",
          "email",
          "actor_type",
          "status",
          "aggregate_version",
          "created_at"
        ],
        "title": "UserRegisteredResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "SportApp - Usuarios",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/jwks.json": {
      "get": {
        "operationId": "get_jwks__well_known_jwks_json_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonWebKeySet"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Claves públicas de firma de access tokens (HU003)",
        "tags": [
          "sessions"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/sessions": {
      "post": {
        "operationId": "create_session_v1_sessions_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-Client-IP",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Client-Ip"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`invalid_credentials`: credenciales incorrectas o cuenta deshabilitada."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`validation_error`."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`too_many_attempts`: demasiados fallos para este correo e IP.",
            "headers": {
              "Retry-After": {
                "description": "Segundos que faltan para volver a intentar.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Iniciar sesión (HU003)",
        "tags": [
          "sessions"
        ]
      }
    },
    "/v1/sessions/refresh": {
      "post": {
        "operationId": "refresh_v1_sessions_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`invalid_refresh_token`: vencido, revocado, reutilizado o de una cuenta deshabilitada."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`validation_error`."
          }
        },
        "summary": "Renovar la sesión (HU003)",
        "tags": [
          "sessions"
        ]
      }
    },
    "/v1/users": {
      "post": {
        "operationId": "register_v1_users_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRegisteredResponse"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Idempotent-Replayed": {
                "description": "`true` cuando se devuelve el resultado de un reintento.",
                "schema": {
                  "type": "string"
                }
              },
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`email_already_registered` o `idempotency_key_reused`."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`validation_error` o `policies_version_mismatch`."
          }
        },
        "summary": "Registrar usuario (HU001)",
        "tags": [
          "users"
        ]
      }
    }
  }
}
