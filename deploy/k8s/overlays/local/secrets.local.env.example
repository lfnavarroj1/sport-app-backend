# Copiar a `secrets.local.env` (ignorado por Git) y reemplazar cada valor.
# Usar solo letras y números: las contraseñas se insertan en URLs de conexión.
# Valores exclusivamente locales; nunca reutilizar credenciales de GCP.
POSTGRES_ADMIN_PASSWORD=CAMBIAR
USUARIOS_DB_PASSWORD=CAMBIAR
AFILIACION_DB_PASSWORD=CAMBIAR
SERVICIOS_DB_PASSWORD=CAMBIAR
ENTRENAMIENTOS_DB_PASSWORD=CAMBIAR
EVENTOS_DB_PASSWORD=CAMBIAR
